{
  "name": "my-twitter-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators:functions-test": "firebase --config firebase.functions-test.json emulators:start --only auth,firestore,functions --project melink-functions-test",
    "test:admin-auth": "node tests/services/adminAuthService.test.mjs",
    "test:apple-auth-flow": "node tests/pages/appleAuthCompletionFlow.test.mjs",
    "test:apple-auth-debug-page": "node tests/pages/appleAuthDebugPage.test.mjs",
    "test:firebase-client": "node tests/config/firebaseClient.test.mjs",
    "test:legacy-debug-page": "node tests/pages/legacyMigrationDebugPage.test.mjs",
    "test:legacy-prompt": "node tests/pages/legacyMigrationPromptModel.test.mjs",
    "test:legacy-service": "node tests/services/legacyMigrationService.test.mjs",
    "test:user-profile-service": "node tests/services/userProfileService.test.mjs",
    "test:vite-test-env": "node tests/config/viteTestEnv.test.mjs",
    "test:functions": "firebase --config firebase.functions-test.json emulators:exec --only functions,firestore --project melink-functions-test \"set FIRESTORE_EMULATOR_HOST=127.0.0.1:48080&& node tests/functions/checkLegacyMigrationEligibility.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore \"set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080&& node tests/rules/appleAuthRules.test.mjs\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "autoprefixer": "^10.4.27",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.11.0",
    "lucide-react": "^1.7.0",
    "postcss": "^8.5.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.184.0",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.24.0",
    "globals": "^17.4.0"
  }
}
